{
  "name": "maestro-dev",
  "version": "0.3.0",
  "description": "CLI that scaffolds CLAUDE.md, session logs, and project docs for AI-assisted development.",
  "type": "module",
  "bin": {
    "maestro": "./dist/bin/maestro.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "scaffolding",
    "developer-tools",
    "claude",
    "ai-native",
    "project-setup",
    "code-quality"
  ],
  "author": "Shaina Pauley <shainapauley@gmail.com> (https://shainapauley.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Surfrrosa/maestro"
  },
  "homepage": "https://github.com/Surfrrosa/maestro#readme",
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "glob": "13.0.6",
    "minimatch": "10.2.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
